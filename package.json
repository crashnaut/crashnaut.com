{
  "name": "crashnaut.com",
  "author": "Mike Sell",
  "description": "Mike Sell - Senior SDET and Test Automation Blog",
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "engines": {
    "node": "^22.17.0"
  },
  "scripts": {
    "dev": "vite dev",
    "prebuild": "rimraf build && npm run copy:content",
    "build": "vite build",
    "preview": "vite preview",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:unit": "vitest run",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "copy:content": "npm run copy:blog",
    "copy:blog": "cpy 'blog/**/*.*' '!blog/**/*.md' 'static/blog'",
    "g": "node ./scripts/generate",
    "optimize:image": "node ./scripts/optimize-image-cli.js",
    "optimize:images": "node ./scripts/optimize-images.js",
    "postinstall": "svelte-kit sync",
    "og": "node ./scripts/og.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@playwright/test": "^1.64.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.15.3",
    "@typescript-eslint/eslint-plugin": "8.12.2",
    "@typescript-eslint/parser": "8.12.2",
    "cpy-cli": "5.0.0",
    "eslint": "9.13.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-svelte": "2.46.1",
    "front-matter": "4.0.2",
    "marked": "^18.1.0",
    "prettier": "3.6.2",
    "prettier-plugin-svelte": "3.4.0",
    "rimraf": "5.0.10",
    "sharp": "^0.35.5",
    "shiki": "^4.5.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tslib": "2.8.1",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.12.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@axe-core/playwright": {
      "playwright-core": "1.64.0"
    }
  }
}
